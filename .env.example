# Contact form delivery endpoint (optional).
#
# Leave this empty to use the built-in mail-client delivery: the form validates
# the message and opens a pre-filled email in the visitor's mail app.
#
# To send submissions straight to an inbox, paste a JSON-accepting form endpoint:
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
VITE_CONTACT_ENDPOINT=
